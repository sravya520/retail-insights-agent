GOOGLE_API_KEY=your-gemini-api-key-here
# Optional, for Langfuse tracing (Phase 5)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Optional, BigQuery warehouse (cloud phase). Default warehouse is duckdb.
# Key files are paths OUTSIDE the repo, never key contents.
RIA_WAREHOUSE=duckdb
RIA_BQ_PROJECT=
RIA_BQ_DATASET=retail
RIA_BQ_LOCATION=US
RIA_BQ_AGENT_KEY=D:\secrets\ria-agent.json
RIA_BQ_LOADER_KEY=D:\secrets\ria-loader.json
